diff --git a/include/mpv/client.h b/include/mpv/client.h
index 8eb5e05..f60e8da 100644
--- a/include/mpv/client.h
+++ b/include/mpv/client.h
@@ -1838,6 +1838,35 @@ MPV_EXPORT int mpv_hook_add(mpv_handle *ctx, uint64_t reply_userdata,
  */
 MPV_EXPORT int mpv_hook_continue(mpv_handle *ctx, uint64_t id);
 
+/**
+ * Real-time audio PCM tap callback.
+ *
+ * Invoked on the audio playback thread right before samples are committed
+ * to the hardware sound driver. Guarantees access to post-DSP, post-volume,
+ * synchronized canonical float32 PCM in interleaved format.
+ *
+ * @param interleaved Pointer to contiguous float32 interleaved audio samples [-1.0, 1.0)
+ * @param frames Number of audio frames
+ * @param channels Number of audio channels
+ * @param sample_rate Audio sample rate in Hz
+ * @param userdata User data pointer passed to mpv_set_pcm_callback
+ */
+typedef void (*mpv_pcm_callback_fn)(const float *interleaved, int frames, int channels, int sample_rate, void *userdata);
+
+/**
+ * Register or unregister the real-time PCM tap callback.
+ *
+ * When callback is NULL, the PCM tap is disabled and this function blocks
+ * until any in-flight callback invocation on the audio thread has finished.
+ * Once mpv_set_pcm_callback returns, userdata is guaranteed not to be
+ * accessed again and is completely safe to free.
+ *
+ * @param ctx The mpv handle
+ * @param callback The callback function, or NULL to unregister
+ * @param userdata Pointer passed to the callback function
+ */
+MPV_EXPORT void mpv_set_pcm_callback(mpv_handle *ctx, mpv_pcm_callback_fn callback, void *userdata);
+
 #if MPV_ENABLE_DEPRECATED
 
 /**
diff --git a/player/client.c b/player/client.c
index 5087f89..60e90a2 100644
--- a/player/client.c
+++ b/player/client.c
@@ -48,6 +48,7 @@
 #include "command.h"
 #include "core.h"
 #include "client.h"
+#include "audio/out/ao.h"
 
 /*
  * Locking hierarchy:
@@ -1845,6 +1846,32 @@ int mpv_hook_continue(mpv_handle *ctx, uint64_t id)
     return r;
 }
 
+void mpv_set_pcm_callback(mpv_handle *ctx, mpv_pcm_callback_fn callback, void *userdata)
+{
+    struct MPContext *mpctx = ctx ? ctx->mpctx : NULL;
+    if (!mpctx || !mpctx->global || !mpctx->global->pcm_tap)
+        return;
+
+    struct mp_pcm_tap *tap = mpctx->global->pcm_tap;
+
+    // 1. Disable incoming callbacks
+    atomic_store_explicit(&tap->enabled, 0, memory_order_seq_cst);
+
+    // 2. Wait for any in-flight callers on the audio thread to complete
+    while (atomic_load_explicit(&tap->active_callers, memory_order_seq_cst) > 0) {
+        mp_sleep_ns(100 * 1000);
+    }
+
+    // 3. Update callback and userdata
+    atomic_store_explicit(&tap->callback, callback, memory_order_seq_cst);
+    atomic_store_explicit(&tap->userdata, userdata, memory_order_seq_cst);
+
+    // 4. Re-enable if callback is valid
+    if (callback) {
+        atomic_store_explicit(&tap->enabled, 1, memory_order_seq_cst);
+    }
+}
